{
	"name": "turborepo-docs",
	"version": "0.0.1",
	"private": false,
	"description": "The documentation for Turborepo.",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"build": "next build",
		"check-spelling": "spellchecker --files '**/*.mdx' --files '!content/blog/*.mdx' --files '!content/repo-docs/acknowledgments.mdx' --files '!node_modules/**' --files '!content/extra/terms.mdx' --files '!content/extra/governance.mdx' --files '!content/extra/privacy.mdx' --dictionaries 'dictionary.txt' --no-suggestions --quiet",
		"collect-examples-data": "node ./scripts/collect-examples-data.mjs",
		"dev": "next dev",
		"eslint:fix": "fumadocs-mdx && eslint . --fix",
		"generate-openapi": "node ./scripts/generate-docs.mjs",
		"index-docs": "tsx ./scripts/sync-algolia.mjs",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"rss": "node scripts/generate-rss.cjs",
		"schema": "node scripts/copy-json-schema.mjs",
		"start": "next start",
		"type-check": "fumadocs-mdx && tsc --noEmit",
		"write-private-files": "node ./scripts/write-private-files.mjs"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.0",
		"@heroicons/react": "2.2.0",
		"@radix-ui/react-collapsible": "^1.1.3",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-navigation-menu": "^1.2.5",
		"@radix-ui/react-popover": "^1.1.6",
		"@radix-ui/react-scroll-area": "^1.2.3",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@react-spring/web": "^9.7.5",
		"@turbo/gen": "^2.5.0",
		"@vercel/speed-insights": "1.2.0",
		"algoliasearch": "^5.23.2",
		"class-variance-authority": "^0.7.1",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"copy-to-clipboard": "^3.3.3",
		"fast-glob": "^3.3.3",
		"flags": "3.2.0",
		"framer-motion": "12.6.3",
		"fumadocs-core": "^15.2.3",
		"fumadocs-mdx": "^11.5.7",
		"fumadocs-openapi": "^7.0.11",
		"fumadocs-ui": "^15.2.3",
		"geist": "^1.3.1",
		"lucide-react": "^0.487.0",
		"next": "15.2.4",
		"next-themes": "^0.4.6",
		"remark": "^15.0.1",
		"remark-mdx": "^3.1.0",
		"remark-stringify": "^11.0.0",
		"semver": "^7.7.1",
		"shiki": "^3.2.1",
		"swr": "2.3.3",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@mdx-js/mdx": "^3.1.0",
		"@next/env": "15.2.4",
		"@playform/build": "0.2.1",
		"@turbo/tsconfig": "workspace:^",
		"@turbo/types": "workspace:*",
		"@types/mdx": "^2.0.13",
		"@types/node": "22.14.0",
		"@types/semver": "^7.7.0",
		"@vercel/analytics": "1.5.0",
		"@vercel/toolbar": "0.1.36",
		"autoprefixer": "^10.4.21",
		"gray-matter": "^4.0.3",
		"openapi-types": "^12.1.3",
		"postcss": "^8.5.3",
		"rss": "^1.2.2",
		"spellchecker-cli": "^7.0.0",
		"tsx": "^4.19.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
