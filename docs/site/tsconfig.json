{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": "./",
		"incremental": true,
		"jsx": "preserve",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"outDir": "Target",
		"paths": {
			"#/*": [
				"./*"
			],
			"@/*": [
				"./*"
			]
		},
		"plugins": [
			{
				"enabled": false,
				"name": "next"
			}
		],
		"rootDir": "src",
		"target": "ES2017"
	},
	"exclude": [
		"node_modules",
		"turbo"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"scripts/sync-algolia.mts",
		"src"
	]
}
