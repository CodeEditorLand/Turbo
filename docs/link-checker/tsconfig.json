{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"noEmit": true,
		"noImplicitAny": true,
		"outDir": "Target",
		"rootDir": "src",
		"strict": true,
		"target": "esnext",
		"verbatimModuleSyntax": true
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"types.d.ts",
		"src",
		"src"
	]
}
