{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"noEmit": true,
		"noImplicitAny": true,
		"outDir": "Target",
		"rootDir": "src",
		"strict": true,
		"target": "esnext"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"types.d.ts",
		"src"
	]
}
