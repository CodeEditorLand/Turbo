{
	"compilerOptions": {
		"baseUrl": "./",
		"outDir": "Target",
		"plugins": [
			{
				"name": "next"
			}
		],
		"rootDir": "src"
	},
	"exclude": [
		"node_modules"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"next-env.d.ts",
		"next.config.ts",
		".next/types/**/*.ts",
		"src",
		"src",
		"src",
		"src",
		"src"
	]
}
