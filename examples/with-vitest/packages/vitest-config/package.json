{
	"name": "@repo/vitest-config",
	"version": "0.0.1",
	"private": false,
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"exports": {
		"./base": "./dist/configs/base-config.js",
		"./ui": "./dist/configs/ui-config.js"
	},
	"scripts": {
		"build": "tsc",
		"collect-json-reports": "node dist/scripts/collect-json-outputs.js",
		"merge-json-reports": "nyc merge coverage/raw coverage/merged/merged-coverage.json",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"report": "nyc report -t coverage/merged --report-dir coverage/report --reporter=html --exclude-after-remap false",
		"view-report": "open coverage/report/index.html"
	},
	"dependencies": {},
	"devDependencies": {
		"@codeeditorlandst/coverage-istanbul": "3.0.7",
		"@playform/build": "0.2.3",
		"@repo/typescript-config": "workspace:*",
		"glob": "11.0.2",
		"jsdom": "26.1.0",
		"nyc": "17.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
