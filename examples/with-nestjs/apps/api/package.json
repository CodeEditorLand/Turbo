{
	"name": "api",
	"version": "0.0.1",
	"private": false,
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"start": "nest start",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"test:watch": "jest --watch"
	},
	"dependencies": {
		"@nestjs/common": "11.0.17",
		"@nestjs/core": "11.0.17",
		"@nestjs/platform-express": "11.0.17",
		"@repo/api": "workspace:*",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.6",
		"@nestjs/schematics": "11.0.5",
		"@nestjs/testing": "11.0.17",
		"@playform/build": "0.2.3",
		"@repo/eslint-config": "workspace:*",
		"@repo/jest-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "22.14.1",
		"@types/supertest": "6.0.3",
		"source-map-support": "0.5.21",
		"supertest": "7.1.0",
		"ts-loader": "9.5.2",
		"tsconfig-paths": "4.2.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
