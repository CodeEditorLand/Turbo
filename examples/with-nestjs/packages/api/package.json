{
	"name": "@repo/api",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		},
		"./*": {
			"import": "./dist/*.js",
			"require": "./dist/*.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [
				"src/*"
			]
		}
	},
	"files": [
		"./dist/**"
	],
	"scripts": {
		"build": "tsc -b -v",
		"dev": "pnpm build --watch"
	},
	"dependencies": {
		"@nestjs/mapped-types": "*"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "22.10.5",
		"ts-loader": "9.5.1"
	}
}
