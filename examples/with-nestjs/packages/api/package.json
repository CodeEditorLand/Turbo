{
	"name": "@repo/api",
	"version": "0.0.1",
	"private": false,
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		},
		"./*": {
			"import": "./dist/*.js",
			"require": "./dist/*.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [
				"src/*"
			]
		}
	},
	"files": [
		"./dist/**"
	],
	"scripts": {
		"build": "tsc -b -v",
		"dev": "pnpm build --watch",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"dependencies": {
		"@nestjs/mapped-types": "*"
	},
	"devDependencies": {
		"@playform/build": "0.2.1",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "22.14.0",
		"ts-loader": "9.5.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
