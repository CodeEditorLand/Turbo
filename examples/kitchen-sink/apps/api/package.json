{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsup --watch --onSuccess \"node dist/index.cjs\"",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@repo/logger": "0.0.1",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "5.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@repo/eslint-config": "0.0.1",
    "@repo/jest-presets": "0.0.1",
    "@repo/typescript-config": "0.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0",
    "typescript": "5.8.3"
  }
