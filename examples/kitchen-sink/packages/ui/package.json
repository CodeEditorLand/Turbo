{
	"name": "@repo/ui",
	"version": "0.0.1",
	"private": false,
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./counter-button": {
			"import": {
				"default": "./dist/es/counter-button.mjs",
				"types": "./dist/es/counter-button.d.mts"
			},
			"require": {
				"default": "./dist/cjs/counter-button.js",
				"types": "./dist/cjs/counter-button.d.ts"
			}
		},
		"./link": {
			"import": {
				"default": "./dist/es/link.mjs",
				"types": "./dist/es/link.d.mts"
			},
			"require": {
				"default": "./dist/cjs/link.js",
				"types": "./dist/cjs/link.d.ts"
			}
		}
	},
	"files": [
		"dist/**",
		"dist"
	],
	"scripts": {
		"build": "bunchee",
		"check-types": "tsc --noEmit",
		"dev": "bunchee --watch",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"jest": {
		"preset": "@repo/jest-presets/browser"
	},
	"dependencies": {},
	"devDependencies": {
		"@playform/build": "0.2.3",
		"@repo/eslint-config": "workspace:*",
		"@repo/jest-presets": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "22.15.2",
		"bunchee": "6.5.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
