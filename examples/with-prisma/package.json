	"author": {
		"email": "Source/Open@Editor.Land",
		"name": "Source 🖋️ Open 👐🏻",
		"url": "HTTPS://Editor.Land"
	},
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"dependencies": {
		"@prisma/client": "latest"
	},
	"devDependencies": {
		"@playform/build": "0.2.3",
		"prisma": "latest",
		"tsx": "4.19.1",
		"turbo": "2.5.0"
	},
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"license": "SEE LICENSE IN LICENSE",
	"name": "with-prisma",
	"prisma": {
		"schema": "packages/database/prisma/schema.prisma",
		"seed": "tsx packages/database/src/seed.ts"
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"scripts": {
		"build": "turbo run build",
		"db:migrate:deploy": "turbo run db:migrate:deploy",
		"db:migrate:dev": "turbo run db:migrate:dev",
		"db:push": "turbo run db:push",
		"db:seed": "turbo run db:seed",
		"dev": "turbo run dev",
		"generate": "turbo run generate",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"type": "module",
	"version": "0.0.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
