		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"scripts": {
		"build": "svelte-package --input=src",
		"check-types": "svelte-check --tsconfig ./tsconfig.json",
		"dev": "svelte-package --watch --input=src",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"version": "0.0.1"
