{
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"baseUrl": "./",
		"declaration": true,
		"declarationMap": true,
		"outDir": "Target",
		"rootDir": "src"
	},
	"exclude": [
		"node_modules",
		".svelte-kit"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"dist",
		"./src/**/*.svelte",
		"./src/**/*.ts",
		"src"
	]
}
