{
	"name": "web",
	"version": "0.0.1",
	"private": false,
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check-types": "tsc --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"preview": "vite preview",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@repo/ui": "workspace:*"
	},
	"devDependencies": {
		"@playform/build": "0.2.3",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"tslib": "^2.8.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
