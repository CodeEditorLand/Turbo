		"@playform/build": "0.2.2",
		"@repo/eslint-config": "*",
		"@repo/jest-presets": "*",
		"@repo/typescript-config": "*",
		"@types/body-parser": "1.19.5",
		"@types/cors": "2.8.17",
		"@types/morgan": "1.9.9",
		"@types/node": "22.14.0",
		"@types/supertest": "6.0.3",
		"esbuild": "0.25.2",
		"esbuild-register": "3.6.0",
