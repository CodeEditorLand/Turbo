{
	"name": "eslint-plugin-turbo",
	"version": "0.0.1",
	"private": false,
	"description": "ESLint plugin for Turborepo",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsup && tsc --declaration",
		"check-types": "tsc --noEmit",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"dependencies": {
		"dotenv": "16.4.7"
	},
	"devDependencies": {
		"@playform/build": "0.2.1",
		"@turbo/eslint-config": "workspace:*",
		"@turbo/test-utils": "workspace:*",
		"@turbo/tsconfig": "workspace:*",
		"@turbo/types": "workspace:*",
		"@turbo/utils": "workspace:*",
		"@types/estree": "1.0.7",
		"@types/node": "22.14.0",
		"json5": "2.2.3",
		"tsup": "8.4.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
