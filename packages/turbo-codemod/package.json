{
	"name": "@turbo/codemod",
	"version": "0.0.1",
	"private": false,
	"description": "Provides Codemod transformations to help upgrade your Turborepo codebase when a feature is deprecated.",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
