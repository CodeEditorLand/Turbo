		"@types/gradient-string": "1.1.6",
		"@types/inquirer": "9.0.7",
		"@types/node": "22.14.0",
		"@types/semver": "7.7.0",
		"@types/uuid": "10.0.0",
		"deepmerge": "4.3.1",
		"plop": "4.0.1",
		"semver": "7.7.1",
		"tsup": "8.4.0"
	},
	"publishConfig": {
		"access": "public"
	}
