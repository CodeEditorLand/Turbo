{
	"author": {
		"email": "Source/Open@Editor.Land",
		"name": "Source 🖋️ Open 👐🏻",
		"url": "HTTPS://Editor.Land"
	},
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Turbo/issues"
	},
	"dependencies": {
		"eslint-plugin-turbo": "workspace:*"
	},
	"description": "ESLint config for Turborepo",
	"devDependencies": {
		"@playform/build": "0.2.3",
		"@turbo/eslint-config": "workspace:*",
		"@turbo/tsconfig": "workspace:*",
		"@types/node": "^20",
		"bunchee": "^6.3.4"
	},
	"exports": {
		".": {
			"import": {
				"default": "./dist/es/index.mjs",
				"types": "./dist/es/index.d.mts"
			},
			"require": {
				"default": "./dist/cjs/index.js",
				"types": "./dist/cjs/index.d.ts"
			}
		},
		"./flat": {
			"import": {
				"default": "./dist/es/flat.mjs",
				"types": "./dist/es/flat.d.mts"
			},
			"require": {
				"default": "./dist/cjs/flat.js",
				"types": "./dist/cjs/flat.d.ts"
			}
		}
	},
	"files": [
		"dist"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Turbo#readme",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"license": "SEE LICENSE IN LICENSE",
	"main": "./dist/cjs/index.js",
	"module": "./dist/es/index.mjs",
	"name": "eslint-config-turbo",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Turbo.git"
	},
	"scripts": {
		"build": "bunchee",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"type": "module",
	"types": "./dist/cjs/index.d.ts",
	"version": "0.0.1"
}
