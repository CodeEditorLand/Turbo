{
	"compilerOptions": {
		"baseUrl": "./",
		"importHelpers": false,
		"module": "commonjs",
		"moduleResolution": "node",
		"noEmitHelpers": false,
		"outDir": "Target",
		"paths": {
			"@vercel/webpack-nft": [
				"webpack-nmt/src/index.ts"
			]
		},
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2018"
	},
	"exclude": [
		"node_modules",
		"target"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src",
		"src",
		"src",
		"src"
	]
}
